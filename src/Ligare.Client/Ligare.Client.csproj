<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core-style data access that works the same against a local DbContext or a remote Ligare server over OData.</Description>
    <!-- Remote mode plugs into EF Core's query pipeline (EntityQueryProvider/IQueryCompiler), so that
         Include, FirstAsync, ToListAsync and friends work unchanged. These types are EF Core internals. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ligare.Tests" />
  </ItemGroup>

</Project>
